pipeline {
    agent none

    stages {

        stage('Get Code') {
            agent { label 'principal-agent' }
            steps {
                cleanWs()
                bat '''
                    whoami
                    hostname
                    echo %WORKSPACE%
                '''
                git 'https://github.com/JavierCM-92/UNIR-CP1.git'
                stash name: 'source-code', includes: '**/*'
            }
        }

        stage('Tests in Parallel') {
            parallel {

                stage('Unit') {
                    agent { label 'python-agent' }
                    steps {
                        cleanWs()
                        unstash 'source-code'
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            SET PYTHONPATH=.
                            python -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit --junitxml=result-unit.xml
                        '''
                        junit 'result-unit.xml'
                        stash name: 'coverage-data', includes: '.coverage'
                    }
                }

                stage('Rest') {
                    agent { label 'rest-agent' }
                    steps {
                        cleanWs()
                        unstash 'source-code'
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            SET FLASK_APP=app\\api.py
                            start python -m flask run
                            start java -jar C:\\repositorios\\UNIR\\wiremock-standalone-3.13.2.jar --port 9090 -root-dir .\\test\\wiremock
                            python -m pytest --junitxml=result-rest.xml .\\test\\rest
                        '''
                        junit 'result-rest.xml'
                    }
                }

                stage('Static') {
                    agent { label 'quality-agent' }
                    steps {
                        cleanWs()
                        unstash 'source-code'
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            python -m flake8 --exit-zero --format=pylint app > flake8.out
                        '''
                        recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                                     qualityGates: [
                                         [integerThreshold: 8, threshold: 8.0, type: 'TOTAL', unstable: true],
                                         [integerThreshold: 10, threshold: 10.0, type: 'TOTAL', unstable: false]
                                     ]
                    }
                }

                stage('Performance') {
                    agent { label 'rest-agent' }
                    steps {
                        cleanWs()
                        unstash 'source-code'
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            SET FLASK_APP=app\\api.py
                            start python -m flask run
                            C:\\repositorios\\UNIR\\apache-jmeter\\bin\\jmeter -n -t .\\test\\jmeter\\flask.jmx -l flask.jtl
                        '''
                        perfReport sourceDataFiles: 'flask.jtl'
                    }
                }

                stage('Security Test') {
                    agent { label 'security-agent' }
                    steps {
                        cleanWs()
                        unstash 'source-code'
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            python -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                        '''
                        recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                     qualityGates: [
                                         [threshold: 1, type: 'TOTAL', unstable: true],
                                         [threshold: 2, type: 'TOTAL', unstable: false]
                                     ]
                    }
                }
            }
        }

        stage('Coverage') {
            agent { label 'python-agent' }
            steps {
                cleanWs()
                unstash 'source-code'
                unstash 'coverage-data'
                bat '''
                    whoami
                    hostname
                    echo %WORKSPACE%
                    SET PYTHONPATH=.
                    python -m coverage xml
                    python -m coverage html -d coverage_html
                '''
                recordCoverage(
                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                    qualityGates: [
                        [metric: 'LINE', threshold: 95.0],
                        [metric: 'LINE', threshold: 85.0, criticality: 'UNSTABLE'],
                        [metric: 'BRANCH', threshold: 90.0],
                        [metric: 'BRANCH', threshold: 80.0, criticality: 'UNSTABLE']
                    ]
                )
            }
        }
    }
}
