pipeline {
    agent any
 

    stages {
        stage('Get Code') {
            steps {
                // Get some code from a GitHub repository
                git 'https://github.com/JavierCM-92/UNIR-CP1.1.git'
            }
        }
        stage('Build') {
            steps {
                // Python can't be built
                 echo 'Good try :)'
                 echo WORKSPACE
            }
        }
        stage ('Tests')
        { 
            parallel {
                stage('Unit') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                            bat """
                                SET PYTHONPATH=.
                                python -m pytest --junitxml=result-unit.xml .\\test\\unit
                            """
                        }
                    }
                }
                stage('Rest') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                            // se indica start en windows para que no bloquee la ejecucion del bat (ctrl+c)
                            bat """
                                SET FLASK_APP=app\\api.py
                                start python -m flask run
                                start java -jar C:\\repositorios\\UNIR\\wiremock-standalone-3.13.2.jar --port 9090 -root-dir .\\test\\wiremock
                                python -m pytest --junitxml=result-rest.xml .\\test\\rest
                            """
                        }
                    }
                }
            }
        }
        stage('Coverage')
        {
            steps
            {
                 catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                     bat """
                         SET PYTHONPATH=.
                         python -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit
                         python -m coverage xml
                         python -m coverage html -d coverage_html
                        """
                 }
          
            }
        }
        stage('Results') {
            steps {
                junit "result-unit.xml"
                junit "result-rest.xml"
            }
        }
       
        
    }
    // Se ha instalado el plugin publish html ya que cobertura no era compatible con mi version.
    // De esta manera, se genera el html en el paso de cogerage y lo publicamos para poder visualizarlo desde el propio job una vez ha terminado
     post {
            always {
                publishHTML([
                    reportDir: 'coverage_html',
                    reportFiles: 'index.html',
                    reportName: 'Coverage Report',
                    keepAll: true,
                    allowMissing: false
                ])
            }
        }
}
